jvm_auto_instrumentation_agent_path={{ splunk_otel_auto_instrumentation_java_agent_jar }}
nodejs_auto_instrumentation_agent_path=/usr/lib/splunk-instrumentation/splunk-otel-js/node_modules/@splunk/otel/instrument.js
dotnet_auto_instrumentation_agent_path_prefix=/usr/lib/splunk-instrumentation/splunk-otel-dotnet
{% if not with_java %}
auto_instrumentation_disabled=jvm
{% endif %}
{% if not with_nodejs or not npm_found %}
auto_instrumentation_disabled=nodejs
{% endif %}
{% if not with_dotnet %}
auto_instrumentation_disabled=dotnet
{% endif %}
