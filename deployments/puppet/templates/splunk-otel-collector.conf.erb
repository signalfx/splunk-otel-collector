<% unless @splunk_access_token.to_s.strip.empty? -%>
SPLUNK_ACCESS_TOKEN=<%= @splunk_access_token %>
SPLUNK_API_URL=<%= @splunk_api_url %>
<% if @splunk_platform_url.to_s.strip.empty? -%>
SPLUNK_CONFIG=<%= @collector_config_dest %>
<% end -%>
SPLUNK_HEC_TOKEN=<%= @splunk_hec_token %>
SPLUNK_HEC_URL=<%= @splunk_hec_url %>
SPLUNK_INGEST_URL=<%= @splunk_ingest_url %>
SPLUNK_REALM=<%= @splunk_realm %>
<% end -%>
SPLUNK_MEMORY_TOTAL_MIB=<%= @splunk_memory_total_mib %>
<% unless @splunk_listen_interface.to_s.strip.empty? -%>
SPLUNK_LISTEN_INTERFACE=<%= @splunk_listen_interface %>
<% end -%>
<% unless @gomemlimit.to_s.strip.empty? -%>
GOMEMLIMIT=<%= @gomemlimit %>
<% end -%>
<% collector_options = @collector_command_line_args.to_s.strip -%>
<% unless @splunk_platform_url.to_s.strip.empty? -%>
<% platform_logs_options = [] -%>
<% unless @splunk_access_token.to_s.strip.empty? -%>
<% platform_logs_options << "--config #{@collector_config_dest}" -%>
<% end -%>
<% platform_logs_options << '--config /etc/otel/collector/splunk_logs_config_linux.yaml --feature-gates=confmap.enableMergeAppendOption' -%>
<% platform_logs_options = platform_logs_options.join(' ') -%>
<% collector_options = [collector_options, platform_logs_options].reject(&:empty?).join(' ') -%>
<% end -%>
<% unless collector_options.empty? -%>
OTELCOL_OPTIONS=<%= collector_options %>
<% end -%>
<% unless @splunk_platform_url.to_s.strip.empty? -%>
SPLUNK_PLATFORM_URL=<%= @splunk_platform_url %>
SPLUNK_PLATFORM_TOKEN=<%= @splunk_platform_token %>
SPLUNK_FILE_STORAGE_EXTENSION_PATH=/var/lib/otelcol/filelogs
<% unless @splunk_platform_logs_index.to_s.strip.empty? -%>
SPLUNK_PLATFORM_LOGS_INDEX=<%= @splunk_platform_logs_index %>
<% end -%>
<% end -%>

# Custom environment variables.
<% @collector_additional_env_vars.each do |key, value| %>
<%= key %>=<%= value %>
<% end %>
