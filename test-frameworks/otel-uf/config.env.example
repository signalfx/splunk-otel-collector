# ============================================================
# otel-uf-tests environment configuration
# Copy to config.env and fill in values. config.env is gitignored.
# ============================================================

# ------------------------------------------------------------
# SSH access (all three VMs)
# ------------------------------------------------------------
SSH_KEY=
SSH_USER=splunker

# ------------------------------------------------------------
# VM IPs
# ------------------------------------------------------------
UF_HOST=
OTEL_HOST=
SPLUNK_HOST=

# ------------------------------------------------------------
# Splunk Enterprise (VM C)
# ------------------------------------------------------------
SPLUNK_VERSION=9.4.0
# Build hash included in the download filename for some versions.
# Find it on the Splunk release notes page (e.g. 9.4.0 = 6b4ebe426ca6).
# Leave unset if your version uses the plain filename without a hash.
SPLUNK_BUILD_HASH=6b4ebe426ca6
SPLUNK_ADMIN_PASSWORD=

# HEC token used by install_splunk.sh. Store this only in config.env or CI
# secrets; never commit or print it.
SPLUNK_HEC_TOKEN=

# Receiving port for UF S2S
SPLUNK_S2S_PORT=9997

# HEC port for OTel
SPLUNK_HEC_PORT=8088

# Web/REST port
SPLUNK_MGMT_PORT=8089

# ------------------------------------------------------------
# Universal Forwarder (VM A)
# ------------------------------------------------------------
UF_VERSION=9.4.0

# $SPLUNK_HOME on the UF VM
UF_SPLUNK_HOME=/opt/splunkforwarder

# ------------------------------------------------------------
# OTel Collector (VM B)
# ------------------------------------------------------------
# $SPLUNK_HOME layout used by splunk_inputs receiver
OTEL_SPLUNK_HOME=/opt/splunkforwarder

# Path where the otelcol binary will be deployed on VM B
OTEL_BIN_DIR=/usr/local/bin

# The build script derives the collector root from this directory.

# ------------------------------------------------------------
# TA under test
# ------------------------------------------------------------
# Space-separated list of TA directory names to install
# To run the deterministic TA instead of (or in addition to) Splunk_TA_nix:
# TA_LIST=Splunk_TA_otel_uf_test

# Local path to TA packages/directories
TA_SOURCE_DIR=./tas

# File used by Splunk_TA_otel_uf_test. Keep this in sync with the TA stanza
# and TEST_EVENT_FILE in the Makefile if SSH_USER is changed.
TEST_EVENT_FILE=/home/splunker/otel_uf_test.log

# ------------------------------------------------------------
# Splunk indexes
# ------------------------------------------------------------
UF_INDEX=uf_nix
OTEL_INDEX=otel_nix
