#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
REPO_DIR="$( cd "$SCRIPT_DIR" && pwd )"
SOURCE_REPOS_DIR="$(mktemp -d)"
trap 'rm -rf "$SOURCE_REPOS_DIR"' EXIT

OTEL_VERSION="${OTEL_VERSION:-main}"
CORE_VERSION="${CORE_VERSION:-$OTEL_VERSION}"
CONTRIB_VERSION="${CONTRIB_VERSION:-$OTEL_VERSION}"

CORE_REPO_ROOT="$SOURCE_REPOS_DIR/opentelemetry-collector"
CONTRIB_REPO_ROOT="$SOURCE_REPOS_DIR/opentelemetry-collector-contrib"

git clone --depth 1 --branch main \
    https://github.com/open-telemetry/opentelemetry-collector.git \
    "$CORE_REPO_ROOT"
git clone --depth 1 --branch main \
    https://github.com/open-telemetry/opentelemetry-collector-contrib.git \
    "$CONTRIB_REPO_ROOT"

version_commit() {
    local repo_root="$1"
    local version="$2"

    if [[ "$version" == "latest" ]]; then
        return
    fi

    if [[ "$version" == "main" ]]; then
        git -C "$repo_root" rev-parse HEAD
        return
    fi

    printf '%s\n' "$version"
}

sync_module_sets() {
    local commit_hash
    local repo_root="$1"
    local version="$2"

    commit_hash="$(version_commit "$repo_root" "$version")"
    if [[ -n "$commit_hash" ]]; then
        multimod sync -a=true -s=true -v "$REPO_DIR/versions.yaml" \
            -o "$repo_root" --commit-hash "$commit_hash"
    else
        multimod sync -a=true -s=true -v "$REPO_DIR/versions.yaml" \
            -o "$repo_root"
    fi
}

commit_core_sync() {
    if [[ -n "$(git -C "$REPO_DIR" status --porcelain)" ]]; then
        git -C "$REPO_DIR" add -u
        git -C "$REPO_DIR" commit -S \
            -m "[chore] Update OpenTelemetry Core dependencies to $CORE_VERSION"
    fi
}

cd "$REPO_DIR"

echo ">>> Syncing OpenTelemetry Core module sets to $CORE_VERSION ..."
sync_module_sets "$CORE_REPO_ROOT" "$CORE_VERSION"
commit_core_sync

echo ">>> Syncing OpenTelemetry Contrib module sets to $CONTRIB_VERSION ..."
sync_module_sets "$CONTRIB_REPO_ROOT" "$CONTRIB_VERSION"

echo ">>> Tidying Go modules ..."
make -C "$REPO_DIR" tidy-all
